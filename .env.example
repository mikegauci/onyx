# Copy to .env (never commit .env). Placeholders only — no real secrets here.

# --- API (apps/api) ---
ONYX_API_ENVIRONMENT=local
ONYX_API_LOG_LEVEL=INFO
# Comma-separated explicit browser origins (no wildcards)
ONYX_API_CORS_ORIGINS=http://localhost:3001

# --- Platform dashboard (apps/platform) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Local Postgres (infrastructure/docker-compose.yml) ---
POSTGRES_USER=onyx
POSTGRES_PASSWORD=onyx_local_only
POSTGRES_DB=onyx
POSTGRES_PORT=54322
