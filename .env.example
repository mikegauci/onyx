# Copy to .env (never commit .env). Placeholders only — no real secrets here.

# --- API (apps/api) ---
# local | test | preview | production (preview/production enforce https, non-local origins)
ONYX_API_ENVIRONMENT=local
ONYX_API_LOG_LEVEL=INFO
# Comma-separated explicit browser origins (no wildcards)
ONYX_API_CORS_ORIGINS=http://localhost:3001
# Application role. Locally this is the compose superuser; PR-005 adds a separate
# non-owner role that cannot bypass row-level security.
ONYX_API_DATABASE_URL=postgresql+psycopg://onyx:onyx_local_only@127.0.0.1:54322/onyx
# Schema-owner role for Alembic and seeding. Optional locally (falls back to the URL above);
# required in deployed environments.
ONYX_API_MIGRATION_DATABASE_URL=
# Supabase project URL; the API verifies login tokens against its JWKS (ES256).
# Leave blank to disable authenticated routes locally (they return 503).
ONYX_API_SUPABASE_URL=
# Set to 1 to fail (not skip) database tests when Postgres is unreachable. CI sets this.
ONYX_API_REQUIRE_DB=0

# --- Public site (apps/site) ---
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3001

# --- Platform dashboard (apps/platform) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Supabase Auth for sign-in (both public). Leave blank to disable sign-in locally.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Local Postgres (infrastructure/docker-compose.yml) ---
POSTGRES_USER=onyx
POSTGRES_PASSWORD=onyx_local_only
POSTGRES_DB=onyx
POSTGRES_PORT=54322
