# Copy to .env (never commit .env). Placeholders only — no real secrets here.

# --- API (apps/api) ---
# local | test | preview | production (preview/production enforce https, non-local origins)
ONYX_API_ENVIRONMENT=local
ONYX_API_LOG_LEVEL=INFO
# Comma-separated explicit browser origins (no wildcards)
ONYX_API_CORS_ORIGINS=http://localhost:3001
# Connection for requests. Every transaction drops to onyx_app (no RLS bypass) before touching
# data. Locally this is the compose superuser; deployed it must be a non-superuser login role
# that is a member of onyx_app only (see docs/database/schema.md).
ONYX_API_DATABASE_URL=postgresql+psycopg://onyx:onyx_local_only@127.0.0.1:54322/onyx
# Schema-owner role for Alembic and seeding. Optional locally (falls back to the URL above);
# required in deployed environments.
ONYX_API_MIGRATION_DATABASE_URL=
# Supabase project URL; the API verifies login tokens against its JWKS (ES256).
# Leave blank to disable authenticated routes locally (they return 503).
ONYX_API_SUPABASE_URL=
# Set to 1 to fail (not skip) database tests when Postgres is unreachable. CI sets this.
ONYX_API_REQUIRE_DB=0
# AI gateway (server only; never use a NEXT_PUBLIC_ name for these). Leave keys blank locally:
# with no model set, local/test use the built-in fake model, which costs nothing.
ONYX_API_OPENAI_API_KEY=
ONYX_API_ANTHROPIC_API_KEY=
# '<openai|anthropic|fake>:<model>'. Blank in a deployed environment = AI unavailable.
ONYX_API_AI_DEFAULT_MODEL=
# Optional per-workload overrides, JSON: {"diagnostic": "anthropic:<model>"}
ONYX_API_AI_WORKLOAD_MODELS={}
# USD per million tokens for every allowed model, JSON with decimal strings. Unpriced = refused.
# {"openai:<model>": {"input_usd_per_mtok": "0.00", "output_usd_per_mtok": "0.00"}}
ONYX_API_AI_MODEL_PRICES={}
# Email connector (Resend; server only). Leave blank locally: email channels stay "not
# connected" and nothing is sent or received. Real values need the owner's approval.
ONYX_API_RESEND_API_KEY=
ONYX_API_RESEND_WEBHOOK_SECRET=
ONYX_API_EMAIL_INBOUND_DOMAIN=
ONYX_API_EMAIL_FROM_DOMAIN=

# --- Public site (apps/site) ---
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3001

# --- Platform dashboard (apps/platform) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Supabase Auth for sign-in (both public). Leave blank to disable sign-in locally.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Local Postgres (infrastructure/docker-compose.yml) ---
POSTGRES_USER=onyx
POSTGRES_PASSWORD=onyx_local_only
POSTGRES_DB=onyx
POSTGRES_PORT=54322
